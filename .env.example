PROJECT_NAME="AI-Powered Universal Information Logging System"
API_VERSION="v1"
API_V1_STR="/api/v1"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="your-secret-key-min-32-chars-long"
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# Database URL format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/database_name"
GROQ_API_KEY="your-groq-api-key-here"
DEFAULT_MODEL="qwen/qwen3.6-27b"
LANGGRAPH_ENABLED=true
MODEL_TIMEOUT=30
MAX_RETRIES=3
TEMPERATURE=0.7
MAX_TOKENS=4096
DEMO_OFFLINE_MODE=false

# ── LLM Provider ──────────────────────────────────────────────────
# Set to "groq" (default) for cloud inference or "ollama" for fully local/private.
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3


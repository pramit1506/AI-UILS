PROJECT_NAME="AI-Powered Universal Information Logging System"
API_VERSION="v1"
API_V1_STR="/api/v1"
DEBUG=true
# For HTTPS deployments, use AUTH_COOKIE_SECURE=true.
# Uncomment the next line for loopback HTTP only.
# AUTH_COOKIE_SECURE=false
LOG_LEVEL="INFO"
# MUST be replaced with a long, unique random value before deploying.
# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start with an insecure default when DEBUG=False.
SECRET_KEY="your-secret-key-min-32-chars-long"
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# Database URL format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/database_name"

# Free-tier model routing. DEFAULT_MODEL selects Groq in both routing modes.
DEFAULT_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GROQ_FAST_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FAST_MODEL=google/gemma-4-26b-a4b-it:free
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_FREE_TIER_CONFIRMED=false
LANGGRAPH_ENABLED=true
MODEL_TIMEOUT=30
MAX_RETRIES=3
TEMPERATURE=0.7
MAX_TOKENS=4096
DEMO_OFFLINE_MODE=false

# ── LLM Provider ───────────────────────────────────────────────────────────
# Options: "multi" (recommended) | "groq" (single key) | "ollama" (local)
LLM_PROVIDER=multi

# ── Groq API Keys ──────────────────────────────────────────────────────────
# Legacy single key (used when LLM_PROVIDER=groq)
# GROQ_API_KEY=""
SMTP_HOST=""
SMTP_FROM=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_IMPLICIT_TLS=false
# Optional HTTPS recovery mail transport for hosts that block SMTP.
# MAILJET_API_KEY=""
# MAILJET_API_SECRET=""
# Multi-provider pool keys (empty keys are skipped)
# Get free keys at: https://console.groq.com
# GROQ_API_KEY_1=""
# GROQ_API_KEY_2=""
# GROQ_API_KEY_3=""
# GROQ_API_KEY_4=""
# GROQ_API_KEY_5=""
# GROQ_API_KEY_6=""

# ── Google AI Studio (Gemini) API Keys ────────────────────────────────────
# Get free keys at: https://aistudio.google.com/apikey
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""

# ── OpenRouter API Keys ────────────────────────────────────────────────────
# Get free keys at: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY_1=""
# OPENROUTER_API_KEY_2=""
# OPENROUTER_API_KEY_3=""

# ── LiteLLM Router Settings ────────────────────────────────────────────────
ROUTER_NUM_RETRIES=3
ROUTER_RETRY_AFTER=1.5
ROUTER_STRATEGY=simple-shuffle

# ── Context Compression Settings ──────────────────────────────────────────
# Number of conversation turns to keep verbatim before compressing older history.
# Industry standard: 8-12 turns. Default: 10 (= 20 messages).
CONTEXT_COMPRESSION_THRESHOLD=10

# ── Ollama (local/private inference — no API key required) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

PROJECT_NAME="AI-Powered Universal Information Logging System"
API_VERSION="v1"
API_V1_STR="/api/v1"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="your-secret-key-min-32-chars-long"
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# Database URL format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/database_name"

DEFAULT_MODEL="qwen/qwen3.6-27b"
LANGGRAPH_ENABLED=true
MODEL_TIMEOUT=30
MAX_RETRIES=3
TEMPERATURE=0.7
MAX_TOKENS=4096
DEMO_OFFLINE_MODE=false

# ── LLM Provider ───────────────────────────────────────────────────────────
# Options: "multi" (recommended) | "groq" (single key) | "ollama" (local)
LLM_PROVIDER=multi

# ── Groq API Keys ──────────────────────────────────────────────────────────
# Legacy single key (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key-here
# Multi-provider pool keys (up to 3 per provider; empty keys are skipped)
# Get free keys at: https://console.groq.com
GROQ_API_KEY_1=your-groq-api-key-1
GROQ_API_KEY_2=your-groq-api-key-2
GROQ_API_KEY_3=your-groq-api-key-3

# ── Cerebras API Keys ──────────────────────────────────────────────────────
# Get free keys at: https://cloud.cerebras.ai
CEREBRAS_API_KEY_1=your-cerebras-api-key-1
CEREBRAS_API_KEY_2=your-cerebras-api-key-2
CEREBRAS_API_KEY_3=your-cerebras-api-key-3

# ── Google AI Studio (Gemini) API Keys ────────────────────────────────────
# Get free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3

# ── OpenRouter API Keys ────────────────────────────────────────────────────
# Get free keys at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY_1=your-openrouter-api-key-1
OPENROUTER_API_KEY_2=your-openrouter-api-key-2
OPENROUTER_API_KEY_3=your-openrouter-api-key-3

# ── LiteLLM Router Settings ────────────────────────────────────────────────
ROUTER_NUM_RETRIES=3
ROUTER_RETRY_AFTER=1.5
ROUTER_STRATEGY=simple-shuffle

# ── Context Compression Settings ──────────────────────────────────────────
# Number of conversation turns to keep verbatim before compressing older history.
# Industry standard: 8-12 turns. Default: 10 (= 20 messages).
CONTEXT_COMPRESSION_THRESHOLD=10
FAST_ROUTER_MODEL=groq/llama-3.1-8b-instant

# ── Ollama (local/private inference — no API key required) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
